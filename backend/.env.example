# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Example: postgres://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://neondb_owner:npg_password@ep-sample-neon-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Authentication
JWT_SECRET=super_secret_classroom_jwt_attendance_key_2026
JWT_EXPIRES_IN=7d

# Cryptographic Challenge & Replay Config
CHALLENGE_EXPIRY_SECONDS=120
MAX_CLOCK_DRIFT_SECONDS=60
MIN_RSSI_DBM=-85

# Attendance Defaults
DEFAULT_SESSION_DURATION_MINUTES=45
